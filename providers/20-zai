#!/usr/bin/env python3
"""Z.ai coding plan — every quota window.

Key is read from your ZCode config if you have it, otherwise from
~/.config/dev-hud/zai.key
"""
import json, os, sys, urllib.request

UNIT = {1: "minute", 2: "day", 3: "hour", 4: "month", 5: "year", 6: "week"}

def fail(msg):
    print(json.dumps({"name": "Z.ai", "error": msg})); sys.exit(0)

def key():
    p = os.path.expanduser("~/.config/dev-hud/zai.key")
    if os.path.exists(p):
        k = open(p).read().strip()
        if k:
            return k
    try:
        cfg = json.load(open(os.path.expanduser("~/.zcode/v2/config.json")))
        for n in ("builtin:zai-coding-plan", "builtin:zai-start-plan",
                  "builtin:bigmodel-coding-plan"):
            pr = (cfg.get("provider") or {}).get(n) or {}
            o = pr.get("options") or {}
            if pr.get("enabled") and o.get("apiKey"):
                return o["apiKey"]
    except Exception:
        pass
    return None

k = key()
if not k:
    fail("no key — put one in ~/.config/dev-hud/zai.key")

req = urllib.request.Request(
    "https://api.z.ai/api/monitor/usage/quota/limit",
    headers={"Authorization": "Bearer " + k, "Accept": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=15) as r:
        d = json.loads(r.read().decode())
except Exception as e:
    fail(f"request failed: {type(e).__name__}")

if not (d.get("success") or d.get("code") == 200):
    fail(d.get("msg") or "request refused")

data = d.get("data") or {}
wins = []
for lim in data.get("limits") or []:
    n = lim.get("number") or 1
    u = UNIT.get(lim.get("unit"), "window")
    label = "weekly" if (u == "week" and n == 1) else f"{n}-{u}"
    wins.append({"label": label, "pct": lim.get("percentage"),
                 "resets": lim.get("nextResetTime")})

print(json.dumps({"name": "Z.ai", "tier": data.get("level"), "windows": wins}))
